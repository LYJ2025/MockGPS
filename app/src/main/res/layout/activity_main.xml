<?xml version="1.0" encoding="utf-8"?>
<!--
  主容器：玻璃顶栏 + 标签页 + 可左右滑动的三个页面（主页 / 选点 / 轨迹）

  v1.20 改版：背景从纯色 #F3F4F9 改为带色斑的 @drawable/bg_page_aurora，
  顶栏从「?attr/colorPrimary 纯蓝块」改为「?attr/bg_header_glass 半透明白」——
  这就是参考文件 UI优化方案.html 第 02 节方案 A 描述的「柔光毛玻璃」观感。
  文字颜色改为 onSurface 系列，因为现在是白底透明而不是蓝底白字。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_aurora"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="?attr/colorOnSurface"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btn_appearance"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="外观设置"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_tune"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs_main"
        style="@style/Widget.MockGPS.Tab.Pill"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:tabTextAppearance="@style/TabMainText"
        app:elevation="0dp" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
