<?xml version="1.0" encoding="utf-8"?>
<!--
  外观设置页外壳。
  v1.20 修：标题栏底色已改为半透明白（bg_header_glass），
  文字必须用 colorOnSurface/onSurfaceVariant 才看得见 —— 之前用 colorOnPrimary
  （白字）在白底上完全看不见。

  具体选项分组由 AppearanceActivity 按 res/values/arrays.xml 里的
  appearance_*_labels / _values 动态生成 —— 选项定义只有一处，
  以后加一个方案或换一组预设，改 arrays.xml 就够了，不用动 Java 也不用动这个布局。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_aurora"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="外观设置"
            android:textColor="?attr/colorOnSurface"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/appearance_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp" />
    </ScrollView>

</LinearLayout>
