<?xml version="1.0" encoding="utf-8"?>
<!--
  轨迹模拟地图页：手绘 / 折线规划路线，按配速沿路线模拟，并显示真实轨迹。
  与「选点」页是两个独立地图实例。

  改造要点：
    · 浮层与卡片全部改用主题化的样式（Widget.MockGPS.*），配色走 ?attr，随方案/主色/深浅切换。
    · Switch 显式用 MaterialSwitch：framework 的 <Switch> 在未安装 AppCompat viewInflater 的
      Activity 里不会套用主题的 switchStyle，界面会退回老式开关，与设计不一致。
    · 「清空」「清除轨迹」用 Button.Danger（?attr/colorStateDanger），
      停止/撤销用 Button.Ghost，开始用 Button.Primary —— 破坏性操作与普通操作视觉分离。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 左上角浮层：地图源切换 -->
    <HorizontalScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_map"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:checkedButton="@id/src_amap"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/src_amap"
                style="@style/Widget.MockGPS.Segmented"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="62dp"
                android:text="高德" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/src_sat"
                style="@style/Widget.MockGPS.Segmented"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="62dp"
                android:text="卫星" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </HorizontalScrollView>

    <!-- 右下角浮层：缩放 + 回到起点 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="86dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btn_zoom_in"
            style="@style/Widget.MockGPS.Button.MapFloat"
            android:layout_width="@dimen/map_float_button"
            android:layout_height="@dimen/map_float_button"
            android:contentDescription="放大"
            android:src="@drawable/ic_zoom_in" />

        <ImageButton
            android:id="@+id/btn_zoom_out"
            style="@style/Widget.MockGPS.Button.MapFloat"
            android:layout_width="@dimen/map_float_button"
            android:layout_height="@dimen/map_float_button"
            android:layout_marginTop="8dp"
            android:contentDescription="缩小"
            android:src="@drawable/ic_zoom_out" />

        <ImageButton
            android:id="@+id/btn_center_sel"
            style="@style/Widget.MockGPS.Button.MapFloat"
            android:layout_width="@dimen/map_float_button"
            android:layout_height="@dimen/map_float_button"
            android:layout_marginTop="8dp"
            android:contentDescription="回到起点"
            android:src="@drawable/ic_target" />
    </LinearLayout>

    <!-- 底部：轨迹模拟控制区。
         键盘弹起（adjustResize）时窗口高度变小，这里 wrap_content 的卡片会自然上移，
         地图仍保留在上方可见；卡片自身不会把地图压成 0 高度。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_track"
            style="@style/Widget.MockGPS.Card.Glass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!--
              玻璃染色容器：GlassBackdrop 往它的 background 刷一层淡主色。
              用 background 而非内嵌 ImageView —— ImageView 要铺满只能 match_parent，
              而 match_parent 子 View 在 wrap_content 容器里会被量成满屏高度，把卡片顶住；
              为了压住它就得在 Java 里钉死 LayoutParams，钉死后卡片再也缩不回去
              （「点箭头只是隐藏按钮、窗口不缩小」的根因）。background 不参与测量。
            -->
            <FrameLayout
                android:id="@+id/glass_backdrop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="?attr/dimenCardPadding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="轨迹模拟"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btn_track_collapse"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_glass_pill"
                        android:contentDescription="展开/收起"
                        android:rotation="180"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="?attr/colorIconSecondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/track_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/track_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mode_poly"
                            style="@style/Widget.MockGPS.Segmented"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="折线" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mode_free"
                            style="@style/Widget.MockGPS.Segmented"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="画笔" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="配速(km/h)"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/et_speed"
                            style="@style/Widget.MockGPS.TextField"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:hint="8"
                            android:imeOptions="actionDone"
                            android:inputType="numberDecimal"
                            android:maxLength="5"
                            android:text="8" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <!-- 「开始 / 停止 / 继续」三态合一：
                             初始=开始；运行中点一下=停止（暂停、保留进度）；暂停后=继续；
                             模拟跑完或按了「清空」自动回到「开始」。
                             文字与行为由 TrackFragment.updateTrackButton() 统一切换。 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_track_start"
                            style="@style/Widget.MockGPS.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="开始" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_track_undo"
                            style="@style/Widget.MockGPS.Button.Ghost"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="撤销" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_track_clear"
                            style="@style/Widget.MockGPS.Button.Danger"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="清空" />
                    </LinearLayout>

                    <!-- 「开始 / 结束」按钮：两种模式共用，文案由 updateTrackButton/updateDrawButton 切
                         · 画笔模式 →「开始画 / 结束画」（按住地图拖动采集）
                         · 折线模式 →「开始设点 / 结束设点」（点地图依次加节点）
                         按下后整个控制卡片会被收起来，改由 card_draw_end 那个迷你悬浮窗接管，
                         这样点地图时不被面板遮挡；再按一次即恢复。 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_draw_toggle"
                        style="@style/Widget.MockGPS.Button.Ghost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="开始设点" />

                    <!-- GPS 抖动开关：默认开，幅度只有十几厘米（真实 GPS 漂移量级） -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="GPS 抖动（±15cm，更逼真）"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_noise"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- 真实轨迹开关 + 清除 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="显示真实轨迹（绿）"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_trail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_trail_clear"
                            style="@style/Widget.MockGPS.Button.Danger"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:minWidth="0dp"
                            android:text="清除轨迹" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_track_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="未开始：先在地图上画一条路线"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />
                </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!--
      绘制模式下的迷你悬浮窗：点「开始画」后整个控制面板（card_track）隐藏，
      只留这一个按钮浮在底部中央，把地图完全让出来给手绘；
      点「结束画」即结束绘制并恢复整个面板。
      默认 GONE，由 TrackFragment.setDrawingUi() 控制显隐。
    -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_draw_end"
        style="@style/Widget.MockGPS.Card.Glass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_draw_end"
            style="@style/Widget.MockGPS.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:minWidth="132dp"
            android:text="结束画" />
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
