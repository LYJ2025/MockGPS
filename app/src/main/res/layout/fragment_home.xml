<?xml version="1.0" encoding="utf-8"?>
<!--
  主页 Fragment。
  列表高度用 layout_weight="1" 占满剩余空间（不再是固定 170dp），
  并且可以把「坐标设置」区折叠起来，把整屏高度让给行政区 / 收藏列表。

  改造要点：
    · 两张卡片改用 Widget.MockGPS.Card.Glass，内边距走 ?attr/dimenCardPadding（密度预设的落点）。
    · 按钮按语义套样式：应用=Primary / 停止=Ghost / 打开开发者设置=Ghost / 收藏=Tonal。
    · 「坐标设置」折叠按钮的图标换成 ic_chevron_down —— 与设计包图标体系一致；
      Java 里那句 setRotation(expanded ? 0 : 180) 逻辑不用动，chevron 转 180 度正好朝上。
    · 状态胶囊（tv_status / tv_ctrl_summary）的默认底色与字色用主题属性；
      运行中 Java 会按 空闲/正常/警告 三种语义换 drawable 与 @color/state_*_text。
    · 勾选框显式用 MaterialCheckBox：framework <CheckBox> 在未安装 AppCompat viewInflater 的
      Activity 里不会套用主题的 checkboxStyle，界面会退回老式方块。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- 坐标设置（可折叠） -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.MockGPS.Card.Glass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="?attr/dimenCardPadding">

            <!-- 标题行 + 折叠开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="坐标设置"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_ctrl_toggle"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_glass_pill"
                    android:contentDescription="收起 / 展开坐标设置"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="?attr/colorIconSecondary" />
            </LinearLayout>

            <!-- 折叠后的一句话摘要 -->
            <TextView
                android:id="@+id/tv_ctrl_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_idle"
                android:paddingStart="12dp"
                android:paddingTop="9dp"
                android:paddingEnd="12dp"
                android:paddingBottom="9dp"
                android:text="未启用虚拟定位"
                android:textColor="?attr/colorStateIdleText"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- 折叠前的完整表单 -->
            <LinearLayout
                android:id="@+id/panel_ctrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:hint="纬度 Lat">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_lat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberSigned|numberDecimal"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:hint="经度 Lng">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_lng"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberSigned|numberDecimal"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_apply"
                        style="@style/Widget.MockGPS.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="应用虚拟定位" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_stop"
                        style="@style/Widget.MockGPS.Button.Ghost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="停止" />
                </LinearLayout>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb_continuous"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:minHeight="@dimen/button_height_sm"
                    android:text="持续模拟（每秒刷新，防被其他 App 清除）"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_idle"
                    android:paddingStart="13dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="13dp"
                    android:paddingBottom="10dp"
                    android:text="未启用"
                    android:textColor="?attr/colorStateIdleText"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_open_dev"
                    style="@style/Widget.MockGPS.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="前往开发者选项"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 行政区 / 收藏（整块占满剩余高度） -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.MockGPS.Card.Glass"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabs_picker"
                style="@style/Widget.MockGPS.Tab.Pill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="省级行政区" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="地级行政区" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="我的收藏" />
            </com.google.android.material.tabs.TabLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- 行政区下钻面板（省级两级 / 地级三级，由 Fragment 控制层级） -->
                <LinearLayout
                    android:id="@+id/panel_division"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btn_division_back"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_glass_pill"
                            android:contentDescription="返回上级"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_arrow_back"
                            app:tint="?attr/colorIconPrimary"
                            android:visibility="invisible" />

                        <TextView
                            android:id="@+id/tv_division_path"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="选择大区"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_division_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ListView
                        android:id="@+id/lv_division"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:clipToPadding="false"
                        android:divider="@null"
                        android:dividerHeight="0dp"
                        android:fastScrollEnabled="true"
                        android:scrollbarStyle="outsideOverlay" />

                    <TextView
                        android:id="@+id/tv_division_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 我的收藏 -->
                <LinearLayout
                    android:id="@+id/panel_fav"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_fav_add"
                        style="@style/Widget.MockGPS.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="收藏当前坐标（可备注）"
                        app:icon="@drawable/ic_star_outline"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp" />

                    <ListView
                        android:id="@+id/lv_fav"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="10dp"
                        android:layout_weight="1"
                        android:clipToPadding="false"
                        android:divider="@null"
                        android:dividerHeight="0dp"
                        android:scrollbarStyle="outsideOverlay" />

                    <TextView
                        android:id="@+id/tv_fav_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:paddingTop="18dp"
                        android:paddingBottom="18dp"
                        android:text="还没有收藏点\n点上方按钮，或切到地图页收藏当前选中的位置"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        android:visibility="visible" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
