<?xml version="1.0" encoding="utf-8"?>
<!--
  收藏列表单项：实心星标 + 备注名 + 经纬度 + 删除按钮
  配色全部走主题属性，深色模式与主色预设切换时自动跟随。
  图标 tint 用 app:tint。前提是本页所在 Activity 继承 AppCompatActivity，
  AppCompat 的 viewInflater 会把 <ImageView>/<ImageButton> 替换成
  AppCompatImageView/AppCompatImageButton，只有它们才读 app:tint。
  反过来 android:tint 在两种 Activity 下都能用，但 lint 会报 UseAppTint。
  万一哪天换成非 AppCompat 的 Activity，app:tint 会被静默忽略，
  此时图标退回 vector 里自带的 @color/icon_* —— 是合理的兜底色，不会变黑块。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="11dp"
    android:paddingEnd="6dp"
    android:paddingBottom="11dp">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="已收藏"
        android:src="@drawable/ic_star_filled"
        app:tint="?attr/colorPrimary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_fav_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_fav_coord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_fav_delete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="删除收藏"
        android:src="@drawable/ic_delete"
        app:tint="?attr/colorIconTertiary" />

</LinearLayout>
