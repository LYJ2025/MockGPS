<?xml version="1.0" encoding="utf-8"?>
<!--
  MockGPS 设计包 · 颜色资源
  与 tokens/design-tokens.json 的 color 段一一对应。

  两条硬规则（改版时务必遵守）：
  1) 玻璃透明度必须用「颜色资源斜坡」表达（glass_surface_s50 … s95），
     不要用 integer 属性 + 运行时拼 #AARRGGBB。
     原因：cardBackgroundColor / android:background 只吃颜色，吃不下独立的 alpha 整数；
     声明一个 integerGlassAlpha 属性却没人读，就是空转属性（原设计包的 A1 硬伤）。
  2) 主色预设（accent_*）必须成套给出 on_primary / container / on_container，
     只换 colorPrimary 会让卡片、开关、状态栏之间串色（原设计包的 A3 硬伤）。
-->
<resources>

    <!-- ========== 品牌 ========== -->
    <color name="brand_primary">#3BA7EF</color>
    <!-- 真实位置光晕：品牌色 20% 透明（用于 ic_my_location 外圈） -->
    <color name="brand_primary_20">#333BA7EF</color>

    <!-- ========== 主色预设（外观设置页可选，必须成套） ========== -->
    <color name="accent_blue">#3BA7EF</color>
    <color name="accent_blue_on_primary">#FFFFFFFF</color>
    <color name="accent_blue_container">#E1F1FC</color>
    <color name="accent_blue_on_container">#0B3D63</color>

    <color name="accent_teal">#1D9E75</color>
    <color name="accent_teal_on_primary">#FFFFFFFF</color>
    <color name="accent_teal_container">#D8F2E8</color>
    <color name="accent_teal_on_container">#06402B</color>

    <color name="accent_purple">#7F77DD</color>
    <color name="accent_purple_on_primary">#FFFFFFFF</color>
    <color name="accent_purple_container">#E9E7FA</color>
    <color name="accent_purple_on_container">#2F2A66</color>

    <color name="accent_green">#639922</color>
    <color name="accent_green_on_primary">#FFFFFFFF</color>
    <color name="accent_green_container">#E7F2D6</color>
    <color name="accent_green_on_container">#22380A</color>

    <color name="accent_amber">#BA7517</color>
    <color name="accent_amber_on_primary">#FFFFFFFF</color>
    <color name="accent_amber_container">#FAEBD3</color>
    <color name="accent_amber_on_container">#4A2C00</color>

    <!-- ========== 页面与表面 ========== -->
    <!-- 顶栏是半透明白，下面的玻璃与色斑要能透出来 —— 所以 app_bg 用更亮、更有冷调的浅色 -->
    <color name="app_bg">#EEF2F8</color>
    <color name="card_bg">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Material3 角色兜底：让 BottomSheet / Snackbar / 菜单等系统组件也走本设计包配色 -->
    <color name="surface_variant">#E6E8F0</color>
    <color name="on_surface_variant">#5F6070</color>
    <color name="outline">#C9CDD9</color>
    <color name="outline_variant">#E3E6EE</color>

    <!-- ========== 玻璃 ========== -->
    <!--
      这里只放「与透明度无关」的玻璃色。玻璃底色一律走下面的 s50~s95 斜坡 ——
      不要再新增 glass_surface / glass_surface_plain 这类单值键：
      它们和斜坡里的某一档数值完全重复（旧 glass_surface = #B3FFFFFF = s70，
      glass_surface_plain = #E6FFFFFF = s90），存在两套等价写法是 A1 硬伤的温床。
    -->
    <color name="glass_border">#CCFFFFFF</color>
    <color name="glass_highlight">#F2FFFFFF</color>
    <color name="scrim">#66000000</color>

    <!--
      玻璃表面透明度斜坡：外观设置页的滑杆直接在这 10 档里取值（步进 0.05）。
      白蒙版 alpha = 0.50 / 0.55 / … / 0.95。
      方案默认值：A = s70，B = s60，C = s85。
    -->
    <color name="glass_surface_s50">#80FFFFFF</color>
    <color name="glass_surface_s55">#8CFFFFFF</color>
    <color name="glass_surface_s60">#99FFFFFF</color>
    <color name="glass_surface_s65">#A6FFFFFF</color>
    <color name="glass_surface_s70">#B3FFFFFF</color>
    <color name="glass_surface_s75">#BFFFFFFF</color>
    <color name="glass_surface_s80">#CCFFFFFF</color>
    <color name="glass_surface_s85">#D9FFFFFF</color>
    <color name="glass_surface_s90">#E6FFFFFF</color>
    <color name="glass_surface_s95">#F2FFFFFF</color>

    <!-- ========== 文字 ========== -->
    <color name="text_primary">#1B1B1F</color>
    <color name="text_tertiary">#A9B4C2</color>

    <!-- ========== 图标 ========== -->
    <color name="icon_primary">#FF1B1B1F</color>
    <color name="icon_secondary">#FF5F6070</color>
    <color name="icon_tertiary">#FFA9B4C2</color>
    <color name="icon_on_glass_light">#FF0C447C</color>

    <!-- ========== 状态 ========== -->
    <color name="state_idle_bg">#ECEDF3</color>
    <color name="state_idle_text">#5F6070</color>
    <color name="state_ok_bg">#DFF3E6</color>
    <color name="state_ok_text">#0F7A45</color>
    <color name="state_warn_bg">#FDECD9</color>
    <color name="state_warn_text">#A85A00</color>
    <color name="state_danger">#B5342F</color>
    <color name="state_danger_bg">#FBE7E5</color>

    <!-- 启动图标 -->
    <color name="ic_launcher_background">#E1F1FC</color>
</resources>
