<?xml version="1.0" encoding="utf-8"?>
<!--
  MockGPS 设计包 · 外观设置页的选项数组
  与 tokens/theme-options.json 对齐，可直接喂给 Spinner / ChipGroup / 自定义分段控件。
  labels 与 values 顺序一一对应。
-->
<resources>

